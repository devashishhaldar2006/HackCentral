PORT=7777
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hackcentral?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# Firebase Admin SDK credentials (for Google/GitHub OAuth authentication)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-firebase-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xyz@your-firebase-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-firebase-client-id

# Email (Nodemailer for OTP verification and password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Cloudinary (Image and avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API (AI Project Lab & Pitch Deck Generator)
GEMINI_API_KEY=your_gemini_api_key
